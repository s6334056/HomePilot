{
  "name": "homepilot-explorer-eh",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "simulator": "npx @evenrealities/evenhub-simulator \"http://localhost:5173/?simulator=true\"",
    "qr": "npx evenhub qr --http --port 5173",
    "qr:sim": "npx evenhub qr --http --port 5173 --path /?simulator=true",
    "build": "tsc -b && vite build",
    "pack": "npm run build && npx evenhub pack app.json dist -o HomePilotExplorer.ehpk",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.4.0",
    "vite": "^5.3.0"
  }
}
