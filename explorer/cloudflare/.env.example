# File service mode: 'mock' or 'gateway'
# VITE_FILE_SERVICE_MODE=mock
VITE_FILE_SERVICE_MODE=gateway

# Gateway configuration (only used when VITE_FILE_SERVICE_MODE=gateway)
# VITE_GATEWAY_URL=http://127.0.0.1:51887
VITE_GATEWAY_URL=https://xxxxxxxxxxxxxxxxxxxxxxxxx.trycloudflare.com
VITE_GATEWAY_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenCode Server URL (for AI agent integration)
# VITE_OPENCODE_URL=http://localhost:4096
